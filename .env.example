# ── KisanAI backend configuration ─────────────────────────────
# Copy this file to `.env` and adjust as needed.
#
# The advisory layer runs fully offline, building treatment plans directly from
# the curated knowledge base — no API keys or external models required.

# Vision model
KISANAI_TFLITE_MODEL=models/kisanai_efficientnet.tflite
KISANAI_LABELS=models/labels.json
KISANAI_CONFIDENCE_THRESHOLD=0.55

# RAG
KISANAI_KB_PATH=knowledge_base/diseases.json
KISANAI_RAG_INDEX=backend/rag/index

# Text-to-speech: none | gtts
KISANAI_TTS_PROVIDER=none

# Server
KISANAI_HOST=0.0.0.0
KISANAI_PORT=8000
KISANAI_CORS_ORIGINS=http://localhost:5173
